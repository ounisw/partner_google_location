<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_google_location" model="ir.ui.view">
        <field name="name">res.partner.form.google.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='address_name']/following-sibling::div[hasclass('o_address_format')][1]" position="after">
                <field name="location_url" widget="google_location"
                       placeholder="Paste a Google Maps link..."/>
                <field name="partner_latitude" invisible="1"/>
                <field name="partner_longitude" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='geo_localize_button']" position="before">
                <button invisible="not location_url" icon="fa-map-marker"
                        string="Compute based on the Google Maps link" title="Compute from the Google Maps link"
                        name="geo_localize" type="object" class="btn btn-link p-0 d-block"/>
            </xpath>
            <xpath expr="//div[@name='geo_localize_button']/button[@name='geo_localize'][1]" position="attributes">
                <attribute name="invisible">location_url or partner_latitude != 0 or partner_longitude != 0</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div name="google_location_map" class="mt-3"
                     invisible="not partner_latitude and not partner_longitude">
                    <separator string="Location"/>
                    <field name="location_url" widget="google_location_map" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_google_location" model="ir.ui.view">
        <field name="name">res.partner.list.google.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="location_url" string="Location" widget="google_location_link" optional="show" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
